@model CallLogManagementSystem.ViewModels.Reports.EngineerPerformanceViewModel
@{
    ViewData["Title"] = "Engineer Performance";

    string FormatMinutes(double? minutes)
    {
        if (!minutes.HasValue) return "-";
        var ts = TimeSpan.FromMinutes(minutes.Value);
        return ts.TotalDays >= 1 ? $"{(int)ts.TotalDays}d {ts.Hours}h" : $"{ts.Hours}h {ts.Minutes}m";
    }
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-0">Engineer Performance</h4>
        <div class="text-muted small">Reports &rsaquo; Engineer Performance &mdash; @Model.DateFrom?.ToString("dd-MMM-yyyy") to @Model.DateTo?.ToString("dd-MMM-yyyy")</div>
    </div>
    <button type="button" class="btn btn-outline-secondary btn-sm no-print" onclick="window.print()">Print</button>
</div>

<div class="card mb-3 no-print">
    <div class="card-body">
        <form method="get" asp-controller="Reports" asp-action="EngineerPerformance" class="row g-2">
            <div class="col-md-3">
                <label class="form-label small mb-1">Date From</label>
                <input type="date" name="dateFrom" value="@Model.DateFrom?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-md-3">
                <label class="form-label small mb-1">Date To</label>
                <input type="date" name="dateTo" value="@Model.DateTo?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-md-3">
                <label class="form-label small mb-1">Location</label>
                <select name="locationId" class="form-select form-select-sm">
                    <option value="">All</option>
                    @foreach (var opt in Model.LocationOptions)
                    {
                        <option value="@opt.Value" selected="@(Model.LocationId?.ToString() == opt.Value)">@opt.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end gap-1">
                <button type="submit" class="btn btn-sm btn-primary">Apply</button>
                <a asp-controller="Reports" asp-action="EngineerPerformance" class="btn btn-sm btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Engineer</th>
                        <th>Total</th>
                        <th>Open</th>
                        <th>In Progress</th>
                        <th>Resolved</th>
                        <th>Closed</th>
                        <th>Reopened</th>
                        <th>Avg Resolution</th>
                        <th>Critical</th>
                        <th>Line Loss</th>
                        <th>SLA Breaches</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Rows.Any())
                    {
                        <tr><td colspan="11" class="text-center text-muted py-4">No data for the selected filters.</td></tr>
                    }
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td class="fw-semibold">@row.EngineerName</td>
                            <td>@row.TotalCalls</td>
                            <td>@row.OpenCount</td>
                            <td>@row.InProgressCount</td>
                            <td>@row.ResolvedCount</td>
                            <td>@row.ClosedCount</td>
                            <td>@row.ReopenedCount</td>
                            <td>@FormatMinutes(row.AverageResolutionMinutes)</td>
                            <td>@row.CriticalCount</td>
                            <td>@row.LineLossCount</td>
                            <td>
                                @if (row.SlaBreachCount > 0)
                                {
                                    <span class="badge text-bg-danger">@row.SlaBreachCount</span>
                                }
                                else
                                {
                                    <span class="text-muted">0</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
