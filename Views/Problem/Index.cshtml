@model List<CallLogManagementSystem.ViewModels.Masters.ProblemRowVm>
@{
    ViewData["Title"] = "Problems";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-0">Problem Master</h4>
        <div class="text-muted small">Master Configuration &rsaquo; Problems</div>
    </div>
    <a asp-controller="Problem" asp-action="Create" class="btn btn-primary btn-sm">+ Add Problem</a>
</div>

@if (TempData["StatusMessage"] is string status)
{
    <div class="alert alert-success py-2 px-3 small">@status</div>
}

<div class="card">
    <div class="card-body">
        <form method="get" asp-controller="Problem" asp-action="Index" class="row g-2 mb-3">
            <div class="col-auto">
                <input type="text" name="search" value="@ViewBag.Search" class="form-control form-control-sm" placeholder="Search by name..." style="width: 260px;" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-sm btn-outline-secondary">Search</button>
                <a asp-controller="Problem" asp-action="Index" class="btn btn-sm btn-outline-secondary">Reset</a>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Problem Category</th>
                        <th>Module</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="5" class="text-center text-muted py-4">No problems found.</td></tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>@item.ProblemCategoryName</td>
                            <td>@(item.ModuleName ?? "-")</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge text-bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-controller="Problem" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                <form asp-controller="Problem" asp-action="ToggleActive" asp-route-id="@item.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm @(item.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                        @(item.IsActive ? "Deactivate" : "Activate")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
