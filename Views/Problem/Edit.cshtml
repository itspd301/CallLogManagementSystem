@model CallLogManagementSystem.ViewModels.Masters.ProblemFormViewModel
@{
    ViewData["Title"] = "Edit Problem";
}

<h4 class="mb-3">Edit Problem</h4>

<div class="card" style="max-width: 520px;">
    <div class="card-body">
        <form asp-controller="Problem" asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small mb-3" role="alert"></div>
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" autofocus />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ProblemCategoryId" class="form-label"></label>
                <select asp-for="ProblemCategoryId" asp-items="Model.ProblemCategoryOptions" class="form-select">
                    <option value="">-- Select Problem Category --</option>
                </select>
                <span asp-validation-for="ProblemCategoryId" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ModuleId" class="form-label"></label>
                <select asp-for="ModuleId" asp-items="Model.ModuleOptions" class="form-select">
                    <option value="">-- (optional) --</option>
                </select>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label"></label>
            </div>

            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-controller="Problem" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
