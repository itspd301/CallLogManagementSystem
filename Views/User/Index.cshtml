@model CallLogManagementSystem.ViewModels.Administration.UserListViewModel
@{
    ViewData["Title"] = "Users";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-0">User Management</h4>
        <div class="text-muted small">Administration &rsaquo; Users</div>
    </div>
    <a asp-controller="User" asp-action="Create" class="btn btn-primary btn-sm">+ Add User</a>
</div>

@if (TempData["StatusMessage"] is string status)
{
    <div class="alert alert-success py-2 px-3 small">@status</div>
}

<div class="card mb-3">
    <div class="card-body">
        <form method="get" asp-controller="User" asp-action="Index" class="row g-2">
            <div class="col-md-3">
                <input type="text" name="search" value="@Model.Search" class="form-control form-control-sm" placeholder="Search by name or Employee ID..." />
            </div>
            <div class="col-md-2">
                <select name="role" class="form-select form-select-sm">
                    <option value="">All Roles</option>
                    @foreach (var opt in Model.RoleOptions)
                    {
                        <option value="@opt.Value" selected="@(Model.Role == opt.Value)">@opt.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="isActive" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    <option value="true" selected="@(Model.IsActive == true)">Active</option>
                    <option value="false" selected="@(Model.IsActive == false)">Inactive</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-sm btn-outline-secondary">Search</button>
                <a asp-controller="User" asp-action="Index" class="btn btn-sm btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Employee ID</th>
                        <th>Name</th>
                        <th>Designation</th>
                        <th>Location</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Last Login</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">No users found.</td></tr>
                    }
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td><span class="badge text-bg-light border">@item.EmployeeId</span></td>
                            <td>@item.FullName</td>
                            <td>@(item.Designation ?? "-")</td>
                            <td>@(item.LocationName ?? "-")</td>
                            <td><span class="badge text-bg-secondary">@(item.Role ?? "None")</span></td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge text-bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-danger">Inactive</span>
                                }
                            </td>
                            <td class="small">@(item.LastLoginDate?.ToString("dd-MMM-yyyy hh:mm tt") ?? "Never")</td>
                            <td class="text-end">
                                <a asp-controller="User" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                <a asp-controller="User" asp-action="ResetPassword" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Reset Pwd</a>
                                <form asp-controller="User" asp-action="ToggleActive" asp-route-id="@item.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm @(item.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                        @(item.IsActive ? "Deactivate" : "Activate")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-2">
            <div class="text-muted small">@Model.TotalCount total user(s) &mdash; page @Model.Page of @Math.Max(1, Model.TotalPages)</div>
            @if (Model.TotalPages > 1)
            {
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        @for (var p = 1; p <= Model.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.Page ? "active" : "")">
                                <a class="page-link" asp-controller="User" asp-action="Index"
                                   asp-route-search="@Model.Search" asp-route-role="@Model.Role" asp-route-isActive="@Model.IsActive"
                                   asp-route-page="@p" asp-route-pageSize="@Model.PageSize">@p</a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>
