@model CallLogManagementSystem.ViewModels.Administration.UserFormViewModel
@{
    ViewData["Title"] = "Edit User";
}

<h4 class="mb-3">Edit User</h4>

<div class="card" style="max-width: 560px;">
    <div class="card-body">
        <form asp-controller="User" asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small mb-3" role="alert"></div>
            <input type="hidden" asp-for="Id" />

            <div class="row">
                <div class="col-sm-6 mb-3">
                    <label class="form-label">Employee ID</label>
                    <input type="text" class="form-control" value="@Model.EmployeeId" disabled />
                    <input type="hidden" asp-for="EmployeeId" />
                    <div class="form-text">System-controlled — cannot be changed.</div>
                </div>
                <div class="col-sm-6 mb-3">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Designation" class="form-label"></label>
                <input asp-for="Designation" class="form-control" />
            </div>

            <div class="row">
                <div class="col-sm-6 mb-3">
                    <label asp-for="LocationId" class="form-label"></label>
                    <select asp-for="LocationId" asp-items="Model.LocationOptions" class="form-select">
                        <option value="">-- (optional) --</option>
                    </select>
                </div>
                <div class="col-sm-6 mb-3">
                    <label asp-for="Role" class="form-label"></label>
                    <select asp-for="Role" asp-items="Model.RoleOptions" class="form-select">
                        <option value="">-- Select Role --</option>
                    </select>
                    <span asp-validation-for="Role" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label"></label>
                <span asp-validation-for="IsActive" class="text-danger small d-block"></span>
            </div>

            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-controller="User" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
