@model CallLogManagementSystem.ViewModels.Administration.ResetPasswordAdminViewModel
@{
    ViewData["Title"] = "Reset Password";
}

<h4 class="mb-3">Reset Password &mdash; @Model.FullName (@Model.EmployeeId)</h4>

<div class="card" style="max-width: 480px;">
    <div class="card-body">
        <form asp-controller="User" asp-action="ResetPassword" asp-route-id="@Model.UserId" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small mb-3" role="alert"></div>
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="EmployeeId" />
            <input type="hidden" asp-for="FullName" />

            <div class="alert alert-info small">This immediately replaces the user's password. Share the new password with them securely.</div>

            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label"></label>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" autofocus />
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
                <div class="form-text">At least 8 characters, with uppercase, lowercase, a digit, and a symbol.</div>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-warning">Reset Password</button>
            <a asp-controller="User" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
