<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Call Log &amp; Support Management System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app-shell.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="app-body">
    <script>
        // Runs synchronously as the body starts parsing, before the sidebar markup below it
        // paints — so a collapsed preference is applied immediately and never flashes expanded.
        (function () {
            try {
                if (localStorage.getItem('clms.sidebarCollapsed') === '1') {
                    document.body.classList.add('sidebar-collapsed');
                }
            } catch (e) { /* storage unavailable */ }
        })();
    </script>

    <partial name="_Header" />
    <partial name="_Sidebar" />

    <div class="app-content-wrapper">
        <main class="app-content" role="main">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/app-shell.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
