@model CallLogManagementSystem.ViewModels.Account.LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = "_LoginLayout";
}

<div class="login-card">
    <div class="login-brand">
        <div class="login-brand-badge">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6l-3 3-4.3-4.3C.6 7.1 1 10.1 3 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.4-.4.4-1.1 0-1.4z"/>
            </svg>
        </div>
        <h1>Call Log &amp; Support Management System</h1>
        <p>IT / MES Support Portal</p>
    </div>

    <form asp-controller="Account" asp-action="Login" method="post" class="login-form" id="loginForm" novalidate>
        <input type="hidden" asp-for="ReturnUrl" />

        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small mb-3" role="alert"></div>

        <div class="mb-3">
            <label asp-for="EmployeeId" class="form-label"></label>
            <input asp-for="EmployeeId" class="form-control" placeholder="e.g. EMP001" autocomplete="username" autofocus />
            <span asp-validation-for="EmployeeId" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <div class="input-group">
                <input asp-for="Password" class="form-control" id="passwordInput" placeholder="Password" autocomplete="current-password" />
                <button class="btn btn-toggle-password" type="button" id="togglePassword" aria-label="Show password" tabindex="-1">
                    <span id="togglePasswordIcon">Show</span>
                </button>
            </div>
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>

        <div class="mb-3 form-check">
            <input asp-for="RememberMe" class="form-check-input" />
            <label asp-for="RememberMe" class="form-check-label small"></label>
        </div>

        <button type="submit" class="btn btn-login btn-primary w-100 text-white" id="loginSubmitBtn">
            <span class="spinner-border spinner-border-sm-inline d-none" id="loginSpinner" role="status" aria-hidden="true"></span>
            <span id="loginSubmitText">Login</span>
        </button>

        <div class="login-links">
            <a asp-controller="Account" asp-action="ForgotPassword">Forgot Password?</a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        (function () {
            var toggleBtn = document.getElementById('togglePassword');
            var passwordInput = document.getElementById('passwordInput');
            var toggleIcon = document.getElementById('togglePasswordIcon');

            toggleBtn.addEventListener('click', function () {
                var isPassword = passwordInput.getAttribute('type') === 'password';
                passwordInput.setAttribute('type', isPassword ? 'text' : 'password');
                toggleIcon.textContent = isPassword ? 'Hide' : 'Show';
                toggleBtn.setAttribute('aria-label', isPassword ? 'Hide password' : 'Show password');
            });

            // Uses jQuery Validate's own .valid() check (unobtrusive validation, already wired
            // to this form) rather than the native constraint API, which asp-for's data-val-*
            // attributes don't participate in.
            $('#loginForm').on('submit', function () {
                if ($(this).valid()) {
                    $('#loginSubmitBtn').prop('disabled', true);
                    $('#loginSpinner').removeClass('d-none');
                    $('#loginSubmitText').text('Signing in...');
                }
            });
        })();
    </script>
}
