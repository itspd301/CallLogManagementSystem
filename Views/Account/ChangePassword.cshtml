@model CallLogManagementSystem.ViewModels.Account.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

<h4 class="mb-3">Change Password</h4>

<div class="card" style="max-width: 480px;">
    <div class="card-body">
        @if (TempData["StatusMessage"] is string status)
        {
            <div class="alert alert-success py-2 px-3 small">@status</div>
        }

        <form asp-controller="Account" asp-action="ChangePassword" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small mb-3" role="alert"></div>

            <div class="mb-3">
                <label asp-for="CurrentPassword" class="form-label"></label>
                <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label"></label>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
                <div class="form-text">At least 8 characters, with uppercase, lowercase, a digit, and a symbol.</div>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary">Update Password</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
