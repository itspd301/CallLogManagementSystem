@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_LoginLayout";
}

<div class="login-card">
    <div class="login-brand">
        <div class="login-brand-badge">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 1a5 5 0 0 0-5 5v3H6a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-9a2 2 0 0 0-2-2h-1V6a5 5 0 0 0-5-5zm0 2a3 3 0 0 1 3 3v3H9V6a3 3 0 0 1 3-3zm0 10a2 2 0 1 1 0 4 2 2 0 0 1 0-4z"/>
            </svg>
        </div>
        <h1>Forgot Password</h1>
        <p>IT / MES Support Portal</p>
    </div>

    <p class="small text-muted">
        Self-service password reset is not available for this internal system.
        To reset your password, please contact your <strong>System Administrator</strong> or the
        <strong>IT Helpdesk</strong> with your Employee ID. An administrator can reset your
        password from <em>Administration &rarr; Users</em>.
    </p>

    <div class="login-links">
        <a asp-controller="Account" asp-action="Login">&larr; Back to Login</a>
    </div>
</div>
