{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=CallLogManagementSystemDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AppSettings": {
    "ApplicationName": "IT/MES Call Log & Support Management System",
    "CallNumberPrefix": "CALL",
    "SessionTimeoutMinutes": 480
  },
  "FileUpload": {
    "UploadPath": "wwwroot/uploads",
    "MaxFileSizeMB": 10,
    "AllowedExtensions": [ ".png", ".jpg", ".jpeg", ".pdf", ".xlsx", ".txt", ".log" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
